# ============================================================
#  Registro de clases · variables de entorno
#  Copiá este archivo como ".env" y completá los valores.
# ============================================================

# Puerto local del servidor (en Vercel no hace falta).
PORT=3000

# ID de la planilla de Google Sheets.
# Está en la URL: https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
SPREADSHEET_ID=

# Opción A (recomendada en tu computadora):
# ruta al archivo JSON de la cuenta de servicio.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Opción B (recomendada en Vercel):
# pegá acá TODO el contenido del JSON en una sola línea.
# Si usás esta opción, podés dejar vacía la ruta de arriba.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Zona horaria para calcular la pestaña del día.
TZ=America/Argentina/Buenos_Aires

# ------------------------------------------------------------
#  Supabase (OPCIONAL): historial de auditoría de cada carga.
#  Si no completás estos valores, la app funciona igual.
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIT_TABLE=clases_auditoria
